function readStorage(key){
  try{
    const raw = localStorage.getItem(key);
    if(!raw) return [];
    const value = JSON.parse(raw);
    return Array.isArray(value) ? value : [];
  }catch(e){
    console.error(`Browseropslag kon niet worden gelezen voor ${key}:`, e);
    return [];
  }
}

function writeStorage(key, value){
  try{
    localStorage.setItem(key, JSON.stringify(value));
    return true;
  }catch(e){
    console.error(`Browseropslag kon niet worden bijgewerkt voor ${key}:`, e);
    return false;
  }
}

function getStoredProjects(){
  return readStorage(PROJECTS_STORAGE_KEY).map(normalizeProject).filter(Boolean);
}

function storeProjects(projects){
  const normalized = (Array.isArray(projects) ? projects : []).map(normalizeProject).filter(Boolean);
  if(writeStorage(PROJECTS_STORAGE_KEY, normalized)) return true;

  // Base64-foto's kunnen de limiet van localStorage overschrijden.
  // Bewaar in dat geval de projectgegevens zonder foto's als offline cache.
  const withoutPhotos = normalized.map(project => ({ ...project, fotos: [] }));
  const saved = writeStorage(PROJECTS_STORAGE_KEY, withoutPhotos);
  if(saved) console.warn('Projecten lokaal opgeslagen zonder foto’s omdat de browseropslag vol is.');
  return saved;
}

function getStoredLogboek(){
  return readStorage(LOGBOEK_STORAGE_KEY).map(normalizeLogboekEntry).filter(Boolean);
}

function storeLogboek(entries){
  const normalized = (Array.isArray(entries) ? entries : []).map(normalizeLogboekEntry).filter(Boolean);
  return writeStorage(LOGBOEK_STORAGE_KEY, normalized);
}

async function apiCall(action, payload = {}){
  if(!API_URL) throw new Error('API_URL ontbreekt.');

  let response;
  try{
    response = await fetch(API_URL, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      body: JSON.stringify({ action, data: payload })
    });
  }catch(e){
    console.error(`Netwerkfout bij ${action}:`, e);
    throw new Error('De verbinding met Power Automate is mislukt.');
  }

  const responseText = await response.text();
  if(!response.ok){
    console.error(`Power Automate-fout ${response.status}:`, responseText);
    throw new Error(`Power Automate gaf HTTP-status ${response.status}.`);
  }
  if(!responseText.trim()) return {};

  try{
    const data = JSON.parse(responseText);
    console.log(`API-antwoord voor ${action}:`, data);
    return data;
  }catch(e){
    console.error('Power Automate gaf geen geldige JSON terug:', responseText);
    throw new Error('Power Automate gaf geen geldige JSON terug.');
  }
}

function extractCollection(responseData, propertyName){
  if(Array.isArray(responseData)) return responseData;
  if(Array.isArray(responseData?.[propertyName])) return responseData[propertyName];
  if(Array.isArray(responseData?.body?.[propertyName])) return responseData.body[propertyName];
  if(typeof responseData?.body === 'string'){
    try{
      const body = JSON.parse(responseData.body);
      if(Array.isArray(body)) return body;
      if(Array.isArray(body?.[propertyName])) return body[propertyName];
    }catch(e){
      console.warn('Response-body is geen geldige JSON:', e);
    }
  }
  return [];
}

async function getProjects(options={}){
  const forceRefresh=options.forceRefresh===true;
  if(!forceRefresh&&Array.isArray(DATA_CACHE.projects)&&cacheFresh(DATA_CACHE.projectsLoadedAt)) return DATA_CACHE.projects;
  if(!forceRefresh&&DATA_CACHE.projectsPromise) return DATA_CACHE.projectsPromise;
  DATA_CACHE.projectsPromise=(async()=>{
    if(LOCAL_MODE){const x=getStoredProjects().sort((a,b)=>String(b.createdAt).localeCompare(String(a.createdAt)));DATA_CACHE.projects=x;DATA_CACHE.projectsLoadedAt=Date.now();return x;}
    try{
      const r=await apiCall('getProjects',{});
      const x=extractCollection(r,'projects').map(normalizeProject).filter(Boolean).sort((a,b)=>String(b.createdAt).localeCompare(String(a.createdAt)));
      DATA_CACHE.projects=x;DATA_CACHE.projectsLoadedAt=Date.now();storeProjects(x);return x;
    }catch(e){const x=getStoredProjects();if(x.length){DATA_CACHE.projects=x;DATA_CACHE.projectsLoadedAt=Date.now();return x;}throw e;}
    finally{DATA_CACHE.projectsPromise=null;}
  })();
  return DATA_CACHE.projectsPromise;
}
async function getProjectById(id){
  const memoryProject=Array.isArray(DATA_CACHE.projects)?DATA_CACHE.projects.find(p=>String(p.id)===String(id))||null:null;
  if(memoryProject&&cacheFresh(DATA_CACHE.projectsLoadedAt)) return memoryProject;
  const cached=memoryProject||getStoredProjects().find(p=>String(p.id)===String(id))||null;
  if(LOCAL_MODE) return cached;
  try{
    const r = await apiCall('getProject', { id });
    let raw = r?.project ?? r?.body?.project ?? null;
    if(!raw && typeof r?.body === 'string'){
      try{ raw = JSON.parse(r.body)?.project ?? null; }catch(e){}
    }
    const project = normalizeProject(raw);
    if(!project) return cached;
    const projects = getStoredProjects();
    const index = projects.findIndex(p => String(p.id) === String(project.id));
    if(index >= 0) projects[index] = project; else projects.push(project);
    storeProjects(projects);
    DATA_CACHE.projects=projects; DATA_CACHE.projectsLoadedAt=Date.now();
    return project;
  }catch(e){
    if(cached){
      console.warn('API niet beschikbaar. Lokaal project wordt gebruikt.', e);
      return cached;
    }
    throw e;
  }
}

// Schrijft een project naar de lokale cache (upsert op id).
function upsertLocalProject(normalized){
  const projects = getStoredProjects();
  const index = projects.findIndex(p => String(p.id) === String(normalized.id));
  if(index >= 0) projects[index] = normalized; else projects.push(normalized);
  storeProjects(projects);
}

// NIEUW project aanmaken -> Power Automate-actie 'createProject' (maakt een nieuw item).
async function createProject(project){
  const normalized = normalizeProject(project);
  if(!normalized) throw new Error('Ongeldige projectgegevens.');
  if(!normalized.createdAt) normalized.createdAt = new Date().toISOString();

  upsertLocalProject(normalized);

  if(!LOCAL_MODE) await apiCall('createProject', { project: normalized });
  return normalized;
}

// BESTAAND project wijzigen -> Power Automate-actie 'updateProject' (werkt bestaand item bij).
// Stuurt het volledige project mee inclusief 'id' en 'createdAt' zodat de flow het juiste
// SharePoint-item kan terugvinden en bijwerken in plaats van een nieuw item te maken.
async function updateProject(project){
  const normalized = normalizeProject(project);
  if(!normalized) throw new Error('Ongeldige projectgegevens.');
  if(!normalized.id) throw new Error('Project-id ontbreekt; bijwerken niet mogelijk.');
  normalized.modifiedAt = new Date().toISOString();

  upsertLocalProject(normalized);

  if(!LOCAL_MODE) await apiCall('updateProject', { project: normalized });
  return normalized;
}

// Compat-helper: kiest automatisch create of update op basis van of het project al bestaat.
async function saveProject(project, forceCreate){
  const normalized = normalizeProject(project);
  if(!normalized) throw new Error('Ongeldige projectgegevens.');
  const exists = !forceCreate &&
    !!normalized.id &&
    getStoredProjects().some(p => String(p.id) === String(normalized.id));
  return exists ? updateProject(normalized) : createProject(normalized);
}



async function deleteProject(id){
  const remaining=getStoredProjects().filter(p=>String(p.id)!==String(id));
  storeProjects(remaining); DATA_CACHE.projects=remaining; DATA_CACHE.projectsLoadedAt=Date.now();
  if(!LOCAL_MODE) await apiCall('deleteProject', { id });
}

