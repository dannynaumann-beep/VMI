         src="${escapeHtml(fixSignature(rec.sigMonteur))}"
         alt="Handtekening monteur"
         onclick="openLightbox(this.src)">
  </div>
` : ''}

${rec.sigKlant ? `
  <div style="margin-top:10px;">
    <b>Handtekening klant</b><br>
    <img class="ov-sig-img" loading="lazy" decoding="async"
         src="${escapeHtml(fixSignature(rec.sigKlant))}"
         alt="Handtekening klant"
         onclick="openLightbox(this.src)">
  </div>
` : ''}

        <button
          class="small-btn"
          style="margin-top:10px;width:100%;"
          onclick="redownloadPdf('${rec.id}')">
          PDF downloaden
        </button>

      </div>
    `).join('')}
    </div>
  `;
}



function fixSignature(sig){
    if(!sig) return '';
    const value = String(sig).trim();

    if(/^https?:\/\//i.test(value)) return value;
    if(/^data:image\//i.test(value)) return value;

    return 'data:image/png;base64,' + value;
}


async function redownloadPdf(id){

    try{

        const r = await apiCall('getLogboekItem', {
            id: id
        });

        const rec = r?.body?.entry || r?.entry;

        if(!rec){
            throw new Error('Logboekitem niet gevonden');
        }

        rec.sigMonteur = fixSignature(rec.sigMonteur);
        rec.sigKlant   = fixSignature(rec.sigKlant);

        if(typeof rec.checklist === 'string'){
            rec.checklist = JSON.parse(rec.checklist);
        }
if(typeof rec.fotos === 'string'){
    try{
        rec.fotos = JSON.parse(rec.fotos);
    }catch{
        rec.fotos =
            rec.fotos === '-' || !rec.fotos
                ? []
                : [rec.fotos];
    }
}

        const doc = buildPdf(rec);

        doc.save(
            `OpleverdocumentCopy_${rec.klantNaam}_${rec.datum}.pdf`
        );

    }catch(e){

        console.error(
            'PDF opnieuw downloaden is mislukt:',
            e
        );

        alert(
            'PDF genereren mislukt. Bekijk Console (F12).'
        );
    }
}



