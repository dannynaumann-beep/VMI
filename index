const PROJECTS_STORAGE_KEY = 'rubix_projects_v1';
const LOGBOEK_STORAGE_KEY = 'rubix_logboek_v1';

function parseArray(value){
  if(Array.isArray(value)) return value;
  if(typeof value !== 'string' || !value.trim()) return [];
  try{
    const parsed = JSON.parse(value);
    return Array.isArray(parsed) ? parsed : [];
  }catch(e){
    console.warn('Ongeldige arraywaarde ontvangen:', value, e);
    return [];
  }
}

function normalizeProject(project){
  if(!project || typeof project !== 'object') return null;
  return {
    ...project,
    id: String(project.id ?? project.ProjectId ?? ''),
    klantNaam: String(project.klantNaam ?? ''),
    adres:String(project.adres??''),
    datumStart: String(project.datumStart ?? ''),
    datumEind: String(project.datumEind ?? ''),
    opmerkingenVooraf: String(project.opmerkingenVooraf ?? ''),
    startTijdLocatie:String(project.startTijdLocatie??''),
    contactNaam: String(project.contactNaam ?? ''),
    contactTelefoon: String(project.contactTelefoon ?? ''),
    contactEmail: String(project.contactEmail ?? ''),
    projectManagerNaam:String(project.projectManagerNaam??''),
    projectManagerEmail:String(project.projectManagerEmail??''),
    rubixContactNaam: String(project.rubixContactNaam ?? ''),
    werkzaamheden: parseArray(project.werkzaamheden),
    monteurs: parseArray(project.monteurs),
    hotelNodig: project.hotelNodig === true || project.hotelNodig === 'true' || project.hotelNodig === 1,
    hotelNaam: String(project.hotelNaam ?? ''),
    hotelAdres: String(project.hotelAdres ?? ''),
    hotelOpmerkingen: String(project.hotelOpmerkingen ?? ''),
    status: String(project.status ?? 'open'),
