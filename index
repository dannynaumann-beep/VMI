function dashboardDate(value){
  if(!value) return null;
  const d = new Date(String(value).length <= 10 ? `${value}T00:00:00` : value);
  return Number.isNaN(d.getTime()) ? null : d;
}
function dayStart(value){ const d = new Date(value); d.setHours(0,0,0,0); return d; }
function daysFromToday(value){
  const d = dashboardDate(value);
  if(!d) return null;
  return Math.round((dayStart(d)-dayStart(new Date()))/86400000);
}
function getEntryDate(entry){
  return String(entry?.datumStart || entry?.datum || '');
}
function dashboardActionEntries(entries, projects){
  const projectById = Object.fromEntries(projects.map(p => [String(p.id), p]));
  const latestByProject = new Map();
  entries
    .filter(e => String(e?.openstaandeActies || '').trim())
    .slice()
    .sort((a,b) => String(b.completedAt || getEntryDate(b) || '').localeCompare(String(a.completedAt || getEntryDate(a) || '')))
    .forEach(e => {
      const projectId = String(e.projectId || '');
      const key = projectId || `entry:${String(e.id || '')}`;
      if(!latestByProject.has(key)){
        latestByProject.set(key, {...e, project:projectById[projectId] || null});
      }
    });
  return Array.from(latestByProject.values());
}
async function openDashboardProject(projectId){
  if(!projectId) return;
  await openPmForm(String(projectId));
}
async function loadProjectDashboard(){
  const body = document.getElementById('dashboardBody');
  if(!body) return;
  try{
    const [projects, entries] = await Promise.all([getProjects(), getLogboek()]);
    if(!document.getElementById('dashboardBody')) return;
    const openProjects = projects.filter(p => p.status !== 'afgerond');
    const completedProjects = projects.filter(p => p.status === 'afgerond');
    const actions = dashboardActionEntries(entries, projects);
    const pendingActions = actions.filter(a => !a.actiesVerstuurd);
    const returnVisits = entries
      .filter(e => [false,'false',0,'0'].includes(e.projectAfgerond) || String(e.projectAfgerond).toLowerCase()==='false')
      .sort((a,b) => String(b.completedAt || '').localeCompare(String(a.completedAt || '')));
    const upcoming = projects
      .map(p => ({...p, days:daysFromToday(p.datumStart)}))
      .filter(p => p.status !== 'afgerond' && p.days !== null && p.days >= 0 && p.days <= 13)
      .sort((a,b) => a.days-b.days);
    const thisWeekCount = upcoming.filter(p => p.days <= 6).length;
    const workload = {};
    openProjects.forEach(p => (parseArray(p.monteurs) || []).forEach(m => {
      const name = monteurNaam(m) || 'Niet toegewezen';
      workload[name] = (workload[name] || 0) + 1;
    }));
    const workloadRows = Object.entries(workload).sort((a,b) => b[1]-a[1] || a[0].localeCompare(b[0]));
    const latestActionByProject = actions;
    body.innerHTML = `
      <div class="kpi-grid">
        <div class="kpi-card"><div class="kpi-value">${openProjects.length}</div><div class="kpi-label">Open projecten</div></div>
        <div class="kpi-card success"><div class="kpi-value">${completedProjects.length}</div><div class="kpi-label">Afgerond</div></div>
        <div class="kpi-card ${pendingActions.length ? 'attention' : ''}"><div class="kpi-value">${pendingActions.length}</div><div class="kpi-label">Acties niet doorgegeven</div></div>
        <div class="kpi-card"><div class="kpi-value">${thisWeekCount}</div><div class="kpi-label">Komende 7 dagen</div></div>
      </div>
      <div class="dashboard-grid">
        <div class="dash-panel danger">
          <h3>⚠ Direct aandacht nodig</h3>
          ${pendingActions.length ? pendingActions.slice(0,5).map(a => `
            <div class="action-card">
