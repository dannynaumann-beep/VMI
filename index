              <div class="action-meta">${escapeHtml(a.klantNaam || a.project?.klantNaam || 'Onbekende klant')} · bezoek ${formatDate(getEntryDate(a))}</div>
              <span class="action-status danger">Nog niet doorgegeven</span>
              ${a.projectId ? `<div style="margin-top:7px;"><button class="dash-link" onclick="void openDashboardProject('${escapeHtml(String(a.projectId))}')">Project openen</button></div>` : ''}
            </div>`).join('') : '<p class="dash-empty">Geen acties die nog doorgegeven moeten worden.</p>'}
        </div>
        <div class="dash-panel">
          <h3>🔄 Terugkombezoeken</h3>
          ${returnVisits.length ? returnVisits.slice(0,5).map(v => `
            <div class="action-card">
              <div class="action-title">${escapeHtml(v.klantNaam || 'Onbekende klant')}</div>
              <div class="action-meta">Laatste bezoek: ${formatDate(getEntryDate(v))}${v.monteurNaam ? ` · ${escapeHtml(v.monteurNaam)}` : ''}</div>
              ${v.openstaandeActies ? `<div class="action-meta"><b>Actie:</b> ${escapeHtml(v.openstaandeActies)}</div>` : ''}
              <span class="action-status">Vervolg nodig</span>
            </div>`).join('') : '<p class="dash-empty">Geen terugkombezoeken geregistreerd.</p>'}
        </div>
        <div class="dash-panel">
          <h3>📅 Planning komende 14 dagen</h3>
          ${upcoming.length ? upcoming.slice(0,8).map(p => `
            <div class="planning-line">
              <div class="planning-date">${formatDate(p.datumStart)}</div>
              <div><div class="planning-customer">${escapeHtml(p.klantNaam || 'Onbekende klant')}</div><div class="planning-detail">${parseArray(p.monteurs).map(m => escapeHtml(monteurNaam(m))).join(', ') || 'Niet toegewezen'}</div></div>
            </div>`).join('') : '<p class="dash-empty">Geen open projecten gepland in de komende 14 dagen.</p>'}
        </div>
        <div class="dash-panel">
          <h3>👷 Werkdruk open projecten</h3>
          ${workloadRows.length ? workloadRows.slice(0,8).map(([name,count]) => `
            <div class="workload-line"><span>${escapeHtml(name)}</span><span class="workload-count">${count} project${count===1?'':'en'}</span></div>`).join('') : '<p class="dash-empty">Nog geen medewerkers aan open projecten toegewezen.</p>'}
        </div>
        <div class="dash-panel span-2">
          <h3>📌 Laatste openstaande acties per project</h3>
