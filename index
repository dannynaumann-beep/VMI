const debouncedLogSearch=debounce(v=>{logboekFilter.search=v;loadLogboekList();},300);
function onLogSearchInput(v){debouncedLogSearch(v);}
function setLogStatusFilter(s){ logboekFilter.status = s; loadLogboekList(); }

async function loadLogboekList(){
  const body = document.getElementById('logListBody');
  if(!body) return;
  try{
    const [projects, entries] = await Promise.all([getProjects(), getLogboek()]);
    const byProject = {};
    entries.forEach(e => { (byProject[e.projectId] = byProject[e.projectId] || []).push(e); });
    let rows = Object.keys(byProject).map(pid => {
      const proj = projects.find(p => p.id === pid);
      const visits = byProject[pid].slice().sort((a,b) => b.completedAt.localeCompare(a.completedAt));
      const status = proj ? proj.status : (visits[0].projectAfgerond ? 'afgerond' : 'open');
      return { projectId: pid, klantNaam: visits[0].klantNaam, adres: visits[0].adres, status, visits };
    });
    if(logboekFilter.status !== 'alle') rows = rows.filter(r => r.status === logboekFilter.status);
    const s = logboekFilter.search.trim().toLowerCase();
    if(s) rows = rows.filter(r => r.klantNaam.toLowerCase().includes(s));
    rows.sort((a,b) => b.visits[0].completedAt.localeCompare(a.visits[0].completedAt));

    if(rows.length === 0){
      body.innerHTML = `<div class="empty-state"><div class="ic">📒</div><p>Geen resultaten gevonden.</p></div>`;
      return;
    }
    body.innerHTML = rows.map(r => `
      <div class="log-card" onclick="setView('logboekDetail', {projectId:'${r.projectId}'})">
        <div class="pc-top"><div><div class="pc-name">${escapeHtml(r.klantNaam)}</div><div class="pc-addr">${escapeHtml(r.adres)}</div></div><span class="badge ${r.status==='afgerond'?'done':'open'}">${r.status==='afgerond'?'Afgerond':'Open'}</span></div>
        <div class="pc-meta">${r.visits.length} bezoek${r.visits.length>1?'en':''} · laatste: ${formatDate(r.visits[0].datum)}</div>
      </div>
    `).join('');
  }catch(e){
    body.innerHTML = `<div class="empty-state"><div class="ic">⚠️</div><p>Kon logboek niet laden.</p></div>`;
  }
}


