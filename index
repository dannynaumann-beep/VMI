let KALENDER_DATA = [];
async function loadKalender() {
  console.log('Kalender: GetKalender2 starten...');

  try {
    const response = await apiCall('GetKalender2', {});
    console.log('Kalender RAW response:', response);

    let data = [];
    const candidates = [
      response,
      response?.Entry,
      response?.entry,
      response?.value,
      response?.body,
      response?.body?.Entry,
      response?.body?.entry,
      response?.body?.value,
      response?.body?.body,
      response?.body?.body?.Entry,
      response?.body?.body?.entry,
      response?.body?.body?.value
    ];

    data = candidates.find(Array.isArray) || [];

    if (!data.length && typeof response?.body === 'string') {
      try {
        const parsedBody = JSON.parse(response.body);
        const bodyCandidates = [
          parsedBody,
          parsedBody?.Entry,
          parsedBody?.entry,
          parsedBody?.value,
          parsedBody?.body,
          parsedBody?.body?.Entry,
          parsedBody?.body?.entry,
          parsedBody?.body?.value
        ];
        data = bodyCandidates.find(Array.isArray) || [];
      } catch (parseError) {
        console.error('Kalender: response.body is geen geldige JSON:', parseError);
      }
    }

    KALENDER_DATA = data
      .filter(item => item && typeof item === 'object')
      .slice()
      .sort((a, b) =>
        String(a.ISO || a.Start || a.start || '').localeCompare(
          String(b.ISO || b.Start || b.start || '')
        )
      );

    console.log('Kalender geladen:', KALENDER_DATA.length, 'regels', KALENDER_DATA);
    return KALENDER_DATA;
  } catch (e) {
    KALENDER_DATA = [];
    console.error('Kalender laden mislukt:', e);
    throw e;
  }
}

