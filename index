  if(!secondConfirmed) return;
  const buttons = document.querySelectorAll('.danger-btn');
  buttons.forEach(button => button.disabled = true);
  showDeleteProjectMessage('Project verwijderen…', 'success');
  try{
    await deleteProject(id);
