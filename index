function buildPdf(record){
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF({ unit:'mm', format:'a4' });
  const marginX = 18;
  let y = 20;

  doc.setFillColor(5,30,80);
  doc.rect(0,0,210,30,'F');
  try{ doc.addImage(document.getElementById('homeLogo').src, 'PNG', marginX, 8, 32, 13.85); }catch(e){}
  doc.setTextColor(255,222,0); doc.setFont('helvetica','bold'); doc.setFontSize(15);
  doc.text('OPLEVERDOCUMENT', 210-marginX, 18, {align:'right'});

  y = 42; doc.setTextColor(15,27,46);
  doc.setFont('helvetica','bold'); doc.setFontSize(11); doc.text('Opdrachtgegevens', marginX, y); y += 6;
  doc.setFont('helvetica','normal'); doc.setFontSize(10);
  [['Klant',record.klantNaam],['Adres',record.adres],['Contactpersoon',record.contactNaam||'—'],['Periode',formatDateRange(record.datumStart||record.datum,record.datumEind||record.datum)],['VMI medewerker',record.monteurNaam]].forEach(([l,v]) => {
    doc.setFont('helvetica','bold'); doc.text(l+':', marginX, y);
    doc.setFont('helvetica','normal'); doc.text(String(v), marginX+38, y); y += 6;
  });

  y += 4; doc.setDrawColor(216,211,198); doc.line(marginX,y,210-marginX,y); y += 8;
  doc.setFont('helvetica','bold'); doc.setFontSize(11); doc.text('Uitgevoerde werkzaamheden', marginX, y); y += 7;

  doc.setFontSize(9.5);
  record.checklist.forEach(item => {
    if(y > 265){ doc.addPage(); y = 20; }
    doc.setFont('helvetica','bold');
    doc.setTextColor(item.checked?30:190, item.checked?110:60, item.checked?60:40);
    doc.text(item.checked ? '[X]' : '[ ]', marginX, y);
    doc.setTextColor(15,27,46); doc.setFont('helvetica','normal');
    const lines = doc.splitTextToSize(item.text, 150);
    doc.text(lines, marginX+9, y); y += lines.length*5;
    if(item.note && item.note.trim()){
      doc.setFont('helvetica','italic'); doc.setFontSize(8.5); doc.setTextColor(90,100,105);
      const noteLines = doc.splitTextToSize('Opmerking: '+item.note, 145);
      doc.text(noteLines, marginX+9, y); y += noteLines.length*4.2;
      doc.setFontSize(9.5); doc.setTextColor(15,27,46);
    }
    y += 2.5;
  });

  if(record.algemeneOpmerkingen && record.algemeneOpmerkingen.trim()){
    if(y > 250){ doc.addPage(); y = 20; }
    y += 4; doc.setDrawColor(216,211,198); doc.line(marginX,y,210-marginX,y); y += 8;
    doc.setFont('helvetica','bold'); doc.setFontSize(11); doc.setTextColor(15,27,46);
    doc.text('Algemene opmerkingen', marginX, y); y += 6;
    doc.setFont('helvetica','normal'); doc.setFontSize(9.5);
    const lines = doc.splitTextToSize(record.algemeneOpmerkingen, 174);
    doc.text(lines, marginX, y); y += lines.length*5;
  }

  if(y > 240){ doc.addPage(); y = 20; }
  y += 4; doc.setDrawColor(216,211,198); doc.line(marginX,y,210-marginX,y); y += 8;
  if(!record.projectAfgerond){
    doc.setFont('helvetica','bold'); doc.setFontSize(11); doc.setTextColor(15,27,46);
    doc.text('Vervolg', marginX, y); y += 6;
    doc.setFont('helvetica','normal'); doc.setFontSize(9.5);
    const boxLines = doc.splitTextToSize('Er is nog een vervolgbezoek nodig om dit project af te ronden. Rubix neemt contact op om een nieuwe afspraak in te plannen.', 174);
    doc.text(boxLines, marginX, y); y += boxLines.length*5 + 4;
  } else {
    doc.setFont('helvetica','bold'); doc.setFontSize(11); doc.setTextColor(15,27,46);
    doc.text('Status', marginX, y); y += 6;
    doc.setFont('helvetica','normal'); doc.setFontSize(9.5);
    doc.text('Dit project is afgerond. Er is geen vervolgbezoek gepland.', marginX, y); y += 8;
  }
  if(record.openstaandeActies && record.openstaandeActies.trim()){
    if(y > 255){ doc.addPage(); y = 20; }
    doc.setFont('helvetica','bold'); doc.setFontSize(10.5); doc.setTextColor(15,27,46);
    doc.text('Openstaande actie(s)', marginX, y); y += 6;
    doc.setFont('helvetica','normal'); doc.setFontSize(9.5);
    const actLines = doc.splitTextToSize(record.openstaandeActies, 174);
    doc.text(actLines, marginX, y); y += actLines.length*5 + 4;
  }

 /* if(record.fotos?.length){if(y>125){doc.addPage();y=20;}doc.setFont('helvetica','bold');doc.setFontSize(11);doc.text('Foto\'s werkzaamheden',marginX,y);y+=7;record.fotos.slice(0,6).forEach((src,i)=>{if(i>0&&i%4===0){doc.addPage();y=20;}const j=i%4,col=j%2,row=Math.floor(j/2);try{doc.addImage(src,'JPEG',marginX+col*88,y+row*48,82,44);}catch(e){}});y+=Math.ceil(Math.min(record.fotos.length,4)/2)*48;}*/


const fotos = Array.isArray(record.fotos)
    ? record.fotos
    : (
        typeof record.fotos === 'string' &&
        record.fotos !== '-' &&
        record.fotos.trim() !== ''
    )
        ? [record.fotos]
        : [];

if (fotos.length) {

    if (y > 125) {
        doc.addPage();
        y = 20;
    }

    doc.setFont('helvetica', 'bold');
    doc.setFontSize(11);
    doc.text("Foto's werkzaamheden", marginX, y);
    y += 7;

    fotos.slice(0, 6).forEach((src, i) => {

        if (i > 0 && i % 4 === 0) {
            doc.addPage();
            y = 20;
        }

        const col = i % 2;
        const row = Math.floor((i % 4) / 2);

        const imgX = marginX + (col * 90);
        const imgY = y + (row * 60);

        try {
            doc.addImage(
                src,
                'JPEG',
                imgX,
                imgY,
                80,
                50
            );
        } catch (e) {
            console.error('Foto toevoegen mislukt:', e);
        }

    });

    y += Math.ceil(Math.min(fotos.length, 4) / 2) * 60;
}

        




  doc.setDrawColor(216,211,198); doc.line(marginX,y,210-marginX,y); y += 10;
  doc.setFont('helvetica','bold'); doc.setFontSize(11); doc.text('Voor akkoord ondertekend', marginX, y); y += 8;

  const sigW = 78, sigH = 30;
  if(record.sigMonteur) doc.addImage(record.sigMonteur, 'PNG', marginX, y, sigW, sigH);
  if(record.sigKlant) doc.addImage(record.sigKlant, 'PNG', marginX+96, y, sigW, sigH);
  y += sigH+3;
  doc.setDrawColor(15,27,46); doc.line(marginX,y,marginX+sigW,y); doc.line(marginX+96,y,marginX+96+sigW,y); y += 5;
  doc.setFont('helvetica','normal'); doc.setFontSize(9);
  doc.text('Monteur: '+record.monteurNaam, marginX, y);
  doc.text('Klant: '+(record.klantOndertekenaar||record.klantNaam),marginX+96,y);

  return doc;
}

