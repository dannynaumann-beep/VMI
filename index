
<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>Rubix Project Planning</title>
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Rubix Planning">
<meta name="theme-color" content="#051E50">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Inter:wght@400;500;600;700&family=Roboto+Mono:wght@500&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<style>
  :root{
    --steel-900:#051E50;
    --steel-800:#0C2C68;
    --steel-700:#1B3A78;
    --steel-100:#DCE3F2;
    --steel-050:#F2F0E9;
    --concrete:#EDEAE2;
    --safety:#FFDE00;
    --safety-dark:#8A6A00;
    --caution:#FFF3B0;
    --go:#4C8C4A;
    --go-bg:#E3F2E1;
    --line:#D8D3C6;
    --text:#0F1B2E;
    --text-mute:#5B6472;
    --white:#FFFFFF;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{background:var(--concrete); color:var(--text); font-family:'Inter',system-ui,sans-serif; min-height:100vh; -webkit-tap-highlight-color:transparent;}
  .app{max-width:640px; margin:0 auto; min-height:100vh; background:var(--steel-050); display:flex; flex-direction:column; box-shadow:0 0 40px rgba(0,0,0,0.08); position:relative;}

  /* Topbar */
  .topbar{background:var(--steel-900); color:var(--steel-050); padding:16px 20px 14px; position:sticky; top:0; z-index:10;}
  .topbar-nav{display:flex; align-items:center; justify-content:space-between; margin-bottom:10px;}
  .back-btn{background:none; border:none; color:var(--steel-100); font-size:14.5px; font-weight:600; cursor:pointer; display:flex; align-items:center; gap:4px; padding:4px 0;}
  .back-btn.hidden{visibility:hidden;}
  .home-logo{height:75px; width:auto; display:block;}
  .logboek-shortcut{background:none; border:none; color:var(--safety); font-size:13px; font-weight:700; cursor:pointer; text-transform:uppercase; letter-spacing:0.02em;}
  .top-title{font-family:'Oswald',sans-serif; font-size:20px; font-weight:600; text-transform:uppercase; letter-spacing:0.01em; margin:0;}
  .top-sub{font-family:'Roboto Mono',monospace; font-size:11px; color:var(--steel-100); opacity:0.75; margin-top:3px;}
  .rungs{display:flex; gap:5px; margin-top:12px;}
  .rung{flex:1; height:6px; background:rgba(255,255,255,0.14); border-radius:2px; position:relative; overflow:hidden;}
  .rung::after{content:''; position:absolute; inset:0; background:var(--safety); transform:scaleX(0); transform-origin:left; transition:transform .3s ease; border-radius:2px;}
  .rung.done::after{transform:scaleX(1);}
  .rung.current::after{transform:scaleX(1); background:var(--caution);}

  .content{flex:1; padding:20px 20px 110px;}
  h1.title{font-family:'Oswald',sans-serif; font-size:21px; font-weight:600; text-transform:uppercase; margin:0 0 4px; color:var(--steel-900);}
  p.sub{color:var(--text-mute); font-size:14px; margin:0 0 20px; line-height:1.4;}

  /* Dashboard */
  .dashboard{margin:2px 0 22px;}
  .dashboard-head{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;margin-bottom:12px;}
  .dashboard-head h2{font-family:'Oswald',sans-serif;font-size:19px;text-transform:uppercase;color:var(--steel-900);margin:0;}
  .dashboard-updated{font-size:11px;color:var(--text-mute);text-align:right;}
  .kpi-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-bottom:14px;}
  .kpi-card{background:var(--white);border:1.5px solid var(--line);border-radius:12px;padding:14px;min-height:91px;}
  .kpi-card.attention{border-color:#C0392B;background:#FDF3F2;}
  .kpi-card.success{border-color:var(--go);background:#F4FAF4;}
  .kpi-value{font-family:'Oswald',sans-serif;font-size:30px;line-height:1;color:var(--steel-900);font-weight:700;}
  .kpi-label{font-size:12px;color:var(--text-mute);font-weight:700;margin-top:7px;text-transform:uppercase;letter-spacing:.02em;}
  .dashboard-grid{display:grid;grid-template-columns:1fr;gap:12px;}
  .dash-panel{background:var(--white);border:1.5px solid var(--line);border-radius:12px;padding:15px;}
  .dash-panel h3{font-family:'Oswald',sans-serif;font-size:14px;text-transform:uppercase;color:var(--steel-800);margin:0 0 10px;}
  .dash-panel.danger{border-color:#C0392B;}
  .dash-empty{font-size:13px;color:var(--text-mute);margin:0;line-height:1.45;}
  .action-card{border-top:1px solid var(--line);padding:11px 0;}
  .action-card:first-of-type{border-top:none;padding-top:0;}
  .action-title{font-size:14px;font-weight:700;color:var(--text);line-height:1.35;}
  .action-meta{font-size:12px;color:var(--text-mute);margin-top:4px;line-height:1.4;}
  .action-status{display:inline-block;margin-top:6px;font-size:10px;font-weight:700;text-transform:uppercase;padding:4px 7px;border-radius:12px;background:var(--caution);color:var(--safety-dark);}
  .action-status.danger{background:#F8D7D4;color:#8E2A20;}
  .dash-link{border:none;background:none;color:var(--steel-800);font-weight:700;font-size:12px;padding:0;cursor:pointer;text-decoration:underline;}
  .planning-line,.workload-line{display:grid;grid-template-columns:72px 1fr;gap:9px;border-top:1px solid var(--line);padding:9px 0;font-size:13px;}
  .planning-line:first-of-type,.workload-line:first-of-type{border-top:none;padding-top:0;}
  .planning-date{font-weight:700;color:var(--steel-800);}
  .planning-customer{font-weight:700;}
  .planning-detail{color:var(--text-mute);font-size:12px;margin-top:2px;}
  .workload-line{grid-template-columns:1fr auto;}
  .workload-count{font-weight:700;color:var(--steel-800);}
  .dashboard-error{background:#FDF3F2;border:1.5px solid #C0392B;color:#8E2A20;border-radius:10px;padding:12px;font-size:13px;}
  @media(min-width:560px){.kpi-grid{grid-template-columns:repeat(4,minmax(0,1fr));}.dashboard-grid{grid-template-columns:1fr 1fr;}.dash-panel.span-2{grid-column:1/-1;}}
  /* Home tiles */
  .tiles{display:flex; flex-direction:column; gap:14px; margin-top:6px;}
  .tile{background:var(--white); border:1.5px solid var(--line); border-radius:14px; padding:20px; display:flex; align-items:center; gap:16px; cursor:pointer; text-align:left;}
  .tile:active{background:var(--steel-050);}
  .tile .tile-icon{width:50px; height:50px; border-radius:12px; background:var(--steel-900); color:var(--safety); display:flex; align-items:center; justify-content:center; font-size:22px; flex-shrink:0;}
  .tile .tile-text h3{margin:0 0 3px; font-family:'Oswald',sans-serif; font-size:16px; text-transform:uppercase; color:var(--steel-900);}
  .tile .tile-text p{margin:0; font-size:13px; color:var(--text-mute);}
  .logboek-tile{background:transparent; border:1.5px dashed var(--line); color:var(--text-mute); font-weight:600; font-size:14px; padding:16px; border-radius:12px; text-align:center; cursor:pointer; margin-top:6px;}

  .setup-banner{background:#FFF3B0; border:1.5px solid #E6C200; color:#5C4A00; border-radius:10px; padding:12px 14px; font-size:13px; line-height:1.5; margin-bottom:18px;}
  .setup-banner b{display:block; margin-bottom:3px; font-size:13.5px;}
  /* Read-only medewerkersplanning */
  .planning-section{margin-top:18px;}
  .planning-table-wrap{overflow-x:auto; border:1.5px solid var(--line); border-radius:10px; background:var(--white);}
  .planning-table{width:100%; min-width:560px; border-collapse:collapse; font-size:12.5px;}
  .planning-table th{background:var(--steel-900); color:var(--white); padding:10px 9px; text-align:left; font-size:11px; text-transform:uppercase; letter-spacing:0.03em; white-space:nowrap;}
  .planning-table td{padding:10px 9px; border-top:1px solid var(--line); vertical-align:top; line-height:1.35;}
  .planning-table tbody tr:nth-child(even){background:var(--steel-050);}
  .planning-table .planning-duration{text-align:center; white-space:nowrap;}
  .planning-empty{margin:0; color:var(--text-mute); font-size:13.5px;}

  /* Fields */
  .field{margin-bottom:15px;}
  .field label{display:block; font-size:12px; font-weight:600; text-transform:uppercase; letter-spacing:0.03em; color:var(--text-mute); margin-bottom:6px;}
  .field input, .field textarea, .field select{width:100%; padding:12.5px 14px; border:1.5px solid var(--line); border-radius:8px; background:var(--white); font-family:'Inter',sans-serif; font-size:15.5px; color:var(--text); outline:none;}
  .field input:focus, .field textarea:focus, .field select:focus{border-color:var(--safety-dark);}
  .field textarea{resize:vertical; min-height:70px;}
  .field select{padding:12.5px 14px;border:1.5px solid var(--line);border-radius:8px;background:var(--white);font-family:'Inter',sans-serif;font-size:15.5px;color:var(--text);outline:none;}
  .field-row{display:flex; gap:12px;}
  .field-row .field{flex:1;}
  .field input.invalid, .field textarea.invalid{border-color:#C0392B; background:#FDF3F2;}
  .error-banner{background:#FDF3F2; border:1.5px solid #C0392B; color:#8E2A20; border-radius:8px; padding:11px 14px; font-size:13.5px; font-weight:600; margin-bottom:16px; display:none;}
  .error-banner.show{display:block;}

  /* Chips + task rows */
  .chip-row{display:flex; flex-wrap:wrap; gap:7px; margin:6px 0 18px;}
  .chip{background:var(--white); border:1.5px solid var(--line); border-radius:20px; padding:7px 12px; font-size:12.5px; font-weight:600; cursor:pointer; color:var(--steel-800);}
  .chip:active{background:var(--steel-100);}
  .section-label{font-size:12px; font-weight:600; text-transform:uppercase; letter-spacing:0.03em; color:var(--text-mute); margin-bottom:8px;}
  .task-row{display:flex; align-items:center; justify-content:space-between; gap:10px; background:var(--white); border:1.5px solid var(--line); border-radius:9px; padding:11px 13px; margin-bottom:8px;}
  .task-row span{font-size:14.5px; line-height:1.3;}
  .task-row button{background:none; border:none; color:var(--text-mute); font-size:18px; cursor:pointer; padding:0 2px; flex-shrink:0;}
  .inline-add-row{background:var(--white); border:1.5px solid var(--line); border-radius:10px; padding:12px; margin-bottom:14px;}
  .inline-add-row input{width:100%; padding:11px 12px; border:1.5px solid var(--line); border-radius:7px; font-size:15px; margin-bottom:8px; font-family:'Inter',sans-serif;}
  .inline-add-row .row-btns{display:flex; gap:8px;}
  .inline-add-row .row-btns button{flex:1; padding:10px; border-radius:7px; border:none; font-weight:700; font-size:13.5px; cursor:pointer;}
  .save-add{background:var(--safety); color:var(--steel-900);}
  .cancel-add{background:var(--steel-050); color:var(--text-mute);}
  .add-item-btn{width:100%; padding:13px; border:2px dashed var(--line); border-radius:10px; background:transparent; color:var(--text-mute); font-size:14px; font-weight:600; cursor:pointer; margin-bottom:8px;}

  /* Photos */
  .photo-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:8px; margin:10px 0 6px;}
  .photo-thumb{position:relative; aspect-ratio:1; border-radius:8px; overflow:hidden; background:var(--steel-050); border:1px solid var(--line); cursor:pointer;}
  .photo-thumb img{width:100%; height:100%; object-fit:cover; display:block;}
  .photo-thumb .rm{position:absolute; top:4px; right:4px; width:22px; height:22px; background:rgba(15,27,46,0.75); color:white; border:none; border-radius:50%; font-size:12px; cursor:pointer; line-height:1;}
  .photo-add-btns{display:flex; gap:10px; margin-bottom:6px;}
  .photo-add-btns button{flex:1; padding:12px; border:1.5px dashed var(--line); background:var(--concrete); border-radius:9px; font-size:13px; font-weight:600; color:var(--text-mute); cursor:pointer;}
  .photo-hint{font-size:11.5px; color:var(--text-mute); margin-bottom:16px;}

  /* Checklist (reuse) */
  .check-item{background:var(--white); border:1.5px solid var(--line); border-radius:10px; padding:14px 14px 12px; margin-bottom:12px;}
  .check-item.checked{border-color:var(--go); background:#F4FAF4;}
  .check-head{display:flex; align-items:flex-start; gap:12px; cursor:pointer;}
  .checkbox{width:26px; height:26px; min-width:26px; border:2px solid var(--steel-700); border-radius:6px; display:flex; align-items:center; justify-content:center; background:var(--white); margin-top:1px;}
  .check-item.checked .checkbox{background:var(--go); border-color:var(--go);}
  .checkbox svg{width:16px; height:16px; opacity:0;}
  .check-item.checked .checkbox svg{opacity:1;}
  .check-text{flex:1; font-size:15px; font-weight:500; line-height:1.35; padding-top:2px;}
  .check-note-label{font-size:11px; color:var(--text-mute); margin:10px 0 5px 38px; text-transform:uppercase; letter-spacing:0.02em; font-weight:600;}
  .check-note{margin-left:38px;}
  .check-note textarea{width:100%; border:1.5px solid var(--line); border-radius:7px; padding:9px 10px; font-size:14px; font-family:'Inter',sans-serif; min-height:40px; resize:vertical; background:var(--steel-050);}

  /* Signature */
  .sig-wrap{background:var(--white); border:1.5px solid var(--line); border-radius:10px; padding:14px; margin-bottom:20px;}
  .sig-title{font-family:'Oswald',sans-serif; font-size:14px; font-weight:600; text-transform:uppercase; color:var(--steel-800); margin-bottom:10px;}
  canvas.pad{width:100%; height:150px; background:#FBFAF6; border:1.5px dashed var(--line); border-radius:8px; touch-action:none; display:block;}
  .sig-actions{display:flex; justify-content:space-between; align-items:center; margin-top:8px;}
  .clear-btn{background:none; border:none; color:var(--safety-dark); font-size:13px; font-weight:600; cursor:pointer;}
  .sig-hint{font-size:12px; color:var(--text-mute);}

  /* Cards / lists */
  .project-card, .log-card{background:var(--white); border:1.5px solid var(--line); border-radius:11px; padding:14px 16px; margin-bottom:11px; cursor:pointer;}
  .project-card:active, .log-card:active{background:var(--steel-050);}
  .pc-top{display:flex; justify-content:space-between; align-items:flex-start; gap:10px;}
  .pc-name{font-weight:700; font-size:15.5px;}
  .pc-addr{font-size:13px; color:var(--text-mute); margin-top:2px;}
  .badge{font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.03em; padding:4px 9px; border-radius:20px; white-space:nowrap; flex-shrink:0;}
  .badge.open{background:var(--caution); color:var(--safety-dark);}
  .badge.done{background:var(--go-bg); color:#2E6B2C;}
  .pc-meta{font-size:12px; color:var(--text-mute); margin-top:9px;}
  .top-actions{display:flex; justify-content:flex-end; margin-bottom:14px;}
  .small-btn{background:var(--steel-900); color:var(--safety); border:none; padding:11px 16px; border-radius:8px; font-size:13.5px; font-weight:700; cursor:pointer;}
  .danger-btn{background:#B42318; color:var(--white); border:none; padding:11px 16px; border-radius:8px; font-size:13.5px; font-weight:700; cursor:pointer;}
  .delete-project-card{cursor:default;}
  .delete-project-actions{display:flex;justify-content:flex-end;margin-top:12px;}
  .delete-project-message{margin-bottom:14px;padding:11px 13px;border-radius:8px;font-size:13px;display:none;}
  .delete-project-message.show{display:block;}
  .delete-project-message.success{background:var(--go-bg);color:#2E6B2C;border:1.5px solid var(--go);}
  .delete-project-message.error{background:#FDF3F2;color:#8E2A20;border:1.5px solid #C0392B;}

  .empty-state{text-align:center; padding:50px 20px; color:var(--text-mute);}
  .empty-state .ic{font-size:36px; margin-bottom:10px;}
  .empty-state p{font-size:14px; line-height:1.5;}

  .detail-section{background:var(--white); border:1.5px solid var(--line); border-radius:11px; padding:16px; margin-bottom:14px;}
  .detail-section h3{font-family:'Oswald',sans-serif; font-size:12px; text-transform:uppercase; letter-spacing:0.03em; color:var(--text-mute); margin:0 0 10px;}
  .detail-row{display:flex; justify-content:space-between; gap:10px; font-size:14.5px; padding:5px 0; border-top:1px solid var(--steel-050);}
  .detail-row:first-of-type{border-top:none;}
  .detail-row span:first-child{color:var(--text-mute); flex-shrink:0;}
  .detail-row span:last-child{font-weight:600; text-align:right;}
  .contact-link{color:var(--steel-800); text-decoration:none; font-weight:600;}
  .task-list-view{font-size:14px; line-height:1.9;}
  .task-list-view .done-mark{color:#2E6B2C;}
  .task-list-view .miss-mark{color:var(--safety-dark);}
  .ov-sig-img{width:100%; max-height:75px; object-fit:contain; background:var(--steel-050); border-radius:6px; margin-top:6px;}
  .loading-txt{text-align:center; padding:40px 0; color:var(--text-mute); font-size:14px;}
  .project-card,.log-card,.dash-panel,.detail-section{content-visibility:auto;contain-intrinsic-size:1px 140px;}

.visits-container{
  display:flex;
  flex-direction:column;
  gap:12px;
  width:100%;
}
.visits-container > .detail-section{
  width:100%;
  margin-bottom:0;
}

  /* Bottom bar */
  .bottombar{position:fixed; bottom:0; left:50%; transform:translateX(-50%); width:100%; max-width:640px; background:var(--white); border-top:1.5px solid var(--line); padding:14px 20px calc(14px + env(safe-area-inset-bottom)); display:none; gap:10px; z-index:10;}
  .bottombar.show{display:flex;}
  .btn{flex:1; padding:15px 18px; border-radius:9px; border:none; font-family:'Inter',sans-serif; font-size:15px; font-weight:700; cursor:pointer; text-transform:uppercase; letter-spacing:0.02em;}
  .btn:active{transform:scale(0.98);}
  .btn.primary{background:var(--safety); color:var(--steel-900);}
  .btn.primary:disabled{background:#D9D4C6; color:#9B968A;}
  .btn.ghost{background:var(--steel-050); color:var(--steel-800); flex:0 0 100px;}
  .btn.wide{flex:1;}

  .success-wrap{text-align:center; padding-top:30px;}
  .success-icon{width:70px; height:70px; border-radius:50%; background:var(--go); color:white; display:flex; align-items:center; justify-content:center; margin:0 auto 18px;}
  .success-icon svg{width:34px; height:34px;}
</style>
</head>
<body>
<div class="app">
  <div class="topbar">
    <div class="topbar-nav">
      <button class="back-btn" id="backBtn" onclick="goBack()">‹ Terug</button>
      <img class="home-logo" id="homeLogo" src="" alt="Rubix" onclick="setView('home')" style="cursor:pointer;">
      <button class="logboek-shortcut" id="logboekShortcut" onclick="setView('logboekList')">📒 Logboek</button>
    </div>
    <h1 class="top-title" id="topTitle">Rubix Project Planning</h1>
    <div class="top-sub" id="topSub" style="display:none;"></div>
    <div class="rungs" id="rungs" style="display:none;"></div>
  </div>

  <div class="content" id="content"></div>

  <div class="bottombar" id="bottombar">
    <button class="btn ghost" id="barBackBtn">Terug</button>
    <button class="btn primary wide" id="barNextBtn">Volgende</button>
  </div>
</div>

<script>
/* =========================================================
   CONFIG
========================================================= */
const API_URL = "https://default7e7582b6e2aa455c8352be9fd4a411.dd.environment.api.powerplatform.com:443/powerautomate/automations/direct/cu/01/workflows/e38a7746c95f445f8c47e5c772eece2e/triggers/manual/paths/invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=I_PRujJfgfVdnzEIzGvdOdsqEkrX6xHeDL4Ya3nChx4"; // <--  Power Automate HTTP-URL 
const LOCAL_MODE = !API_URL;
let localProjects = [];
let localLogboek=[];
let APP_ROLE = null;
let APP_READY = false;
const ROLE_PASSWORDS = Object.freeze({
  manager: 'pm',
  vmi: 'pm'
});
function managerAllowed(){return APP_ROLE==='manager';}

/* =========================================================
   LOGO
========================================================= */
document.getElementById('homeLogo').src = "data:image/png;base64,";

/* =========================================================
   PERFORMANCE: DEBOUNCE, MEMORY CACHE & LAZY LOADERS
========================================================= */
function debounce(fn, delay = 300){
  let timer;
  return function(...args){
    clearTimeout(timer);
    timer = setTimeout(() => fn.apply(this,args), delay);
  };
}
const DATA_CACHE_TTL = 5 * 60 * 1000;
const DATA_CACHE = {projects:null,projectsLoadedAt:0,projectsPromise:null,logboek:null,logboekLoadedAt:0,logboekPromise:null};
function cacheFresh(value){return value > 0 && Date.now()-value < DATA_CACHE_TTL;}
const REFERENCE_LOADERS={managers:null,medewerkers:null,taken:null,kalender:null};
function ensureProjectManagersLoaded(){return REFERENCE_LOADERS.managers ||= loadProjectManagers();}
function ensureVMIMedewerkersLoaded(){return REFERENCE_LOADERS.medewerkers ||= loadVMIMedewerkers();}
function ensureVMITakenLoaded(){return REFERENCE_LOADERS.taken ||= loadVMITaken();}
async function ensureKalenderLoaded(force = false) {
  if (!force && Array.isArray(KALENDER_DATA) && KALENDER_DATA.length > 0) {
    return KALENDER_DATA;
  }
  return await loadKalender();
}

