    fotos: parseArray(project.fotos)
  };
}

function normalizeLogboekEntry(entry){
  if(!entry || typeof entry !== 'object') return null;
  return {
    ...entry,
    id: String(entry.id ?? ''),
    projectId: String(entry.projectId ??
	entry.ProjectId ??
	entry.projectID ??
	entry.ProjectID ??
	''),
    checklist:parseArray(entry.checklist),
    datumStart:String(entry.datumStart??entry.datum??''),
    datumEind:String(entry.datumEind??entry.datumStart??entry.datum??''),
