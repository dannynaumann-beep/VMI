const WIZARD_TITLES = { 1:'Gegevens bevestigen', 2:'Checklist', 3:'Opmerkingen', 4:'Handtekeningen', 5:'Controleren & versturen' };

function renderWizard(c){
  chrome({ title: WIZARD_TITLES[wizardStep], sub:'VMI Medewerker — ' + wizardProject.klantNaam, rungTotal:5, rungCurrent:wizardStep,
    bar:{ showBack:true, onBack: wizardBack, nextLabel: wizardStep===5 ? 'Gegevens opladen' : 'Volgende', onNext: wizardNext } });

  if(wizardStep === 1) return renderWizardStep1(c);
  if(wizardStep === 2) return renderWizardStep2(c);
  if(wizardStep === 3) return renderWizardStep3(c);
  if(wizardStep === 4) return renderWizardStep4(c);
  if(wizardStep === 5) return renderWizardStep5(c);
}

function wizardBack(){
  if(wizardStep === 1){ goBack(); return; }
  wizardStep -= 1; render();
}
function wizardNext(){
  if(!validateWizardStep(wizardStep)) return;
  if(wizardStep === 1){
    sessionMonteur.naam=val('w_monteurNaam');wizardMeta.projectManagerEmail=val('w_projectManagerEmail');wizardMeta.datumStart=val('w_datumStart');wizardMeta.datumEind=val('w_datumEind')||val('w_datumStart');
  }
  if(wizardStep === 5){ finishWizard(); return; }
  wizardStep += 1; render();
}

function validateWizardStep(n){
  if(n === 1){
    const req = ['w_monteurNaam','w_projectManagerEmail','w_datumStart','w_datumEind'];
    let ok = true, firstInvalid = null;
    req.forEach(id => {
      const el = document.getElementById(id);
      const empty = !el.value.trim();
      el.classList.toggle('invalid', empty);
      if(empty){ ok = false; if(!firstInvalid) firstInvalid = el; }
    });
    if(ok&&val('w_datumEind')<val('w_datumStart')){ok=false;document.getElementById('w_datumEind').classList.add('invalid');}
    document.getElementById('w1ErrorBanner').classList.toggle('show',!ok);
    if(firstInvalid) firstInvalid.focus();
    return ok;
  }
  if(n === 4){
    const naamEl=document.getElementById('w_klantOndertekenaar');const ok=!!wizardSigData.monteur&&!!wizardSigData.klant&&!!naamEl?.value.trim();if(naamEl)naamEl.classList.toggle('invalid',!naamEl.value.trim());
    document.getElementById('w4ErrorBanner').classList.toggle('show', !ok);
    return ok;
  }
  return true;
}

